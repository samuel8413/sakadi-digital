---
import type { Landing } from '../../domain/model.ts';
import Section from '../ui/Section.astro';

interface Props {
  addons: Landing['addons'];
}

const { addons } = Astro.props;
---

<Section
  id="complementos"
  eyebrow="Para cualquier proyecto"
  title="Complementos"
  lead={addons.intro}
>
  <ul role="list" class="addons">
    {addons.items.map((item) => (
      <li class:list={{ featured: item.featured }}>
        <span class="name">{item.label}</span>
        {item.featured && <span class="tag">Más solicitado</span>}
        {item.price && <span class="price">{item.price.label}</span>}
      </li>
    ))}
  </ul>
</Section>

<style>
  .addons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-3);
  }

  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .featured {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .name {
    font-weight: 600;
  }

  .tag {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .price {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
