---
import type { Plan } from '../../domain/model.ts';
import ButtonLink from '../ui/ButtonLink.astro';
import Card from '../ui/Card.astro';
import Price from '../ui/Price.astro';
import FeatureValue from './FeatureValue.astro';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const headingId = `${plan.anchor}-titulo`;
---

<Card as="article" id={plan.anchor} labelledby={headingId} featured={plan.featured}>
  {plan.featured && <p class="ribbon">Recomendado</p>}

  <header>
    <h3 id={headingId}>{plan.name}</h3>
    <p class="audience">{plan.audience}</p>
    {plan.price && (
      <p class="price">
        <Price price={plan.price} />
      </p>
    )}
  </header>

  <dl class="features">
    {plan.features.map((feature) => (
      <div>
        <dt>{feature.label}</dt>
        <dd>
          <FeatureValue value={feature.value} />
        </dd>
      </div>
    ))}
  </dl>

  <div class="cta">
    <ButtonLink
      href={plan.inquiryHref}
      icon="whatsapp"
      variant={plan.featured ? 'primary' : 'secondary'}
      context={`plan ${plan.name}`}
    >
      Contratar
    </ButtonLink>
  </div>
</Card>

<style>
  .ribbon {
    position: absolute;
    top: 0;
    right: var(--space-5);
    transform: translateY(-50%);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-button);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--text-xl);
  }

  .audience {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .price {
    margin-block-start: var(--space-4);
  }

  .features {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .features div {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }

  .cta :global(.button) {
    width: 100%;
  }
</style>
