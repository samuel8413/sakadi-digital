---
import type { HTMLAttributes } from 'astro/types';

/**
 * Anchor for off-site destinations. Opens in a new tab with the safe `rel`
 * pair and tells screen-reader users what will happen.
 */
interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className} {...rest}>
  <slot />
  <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
</a>
